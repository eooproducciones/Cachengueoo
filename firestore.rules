rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection document
    match /test/connection {
      allow read: if true;
    }

    // 1. User Profiles
    match /profiles/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && incoming().id == userId;
      allow update: if isOwner(userId) && incoming().id == existing().id;
      allow delete: if isOwner(userId);
    }

    // 2. Events (Public view, staff write)
    match /events/{eventId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 3. Venue Locations (Public view, staff write)
    match /venue_locations/{locationId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 4. Night Notes (Live 6-hour notes)
    match /night_notes/{noteId} {
      allow read, write: if true;
    }

    // 5. Night Stories (Live 6-hour stories)
    match /night_stories/{storyId} {
      allow read, write: if true;
    }

    // 6. Real-time Live Chats
    match /chats/{chatId}/{document=**} {
      allow read, write: if true;
    }

    // 7. Likes & Matches
    match /likes/{likeId} {
      allow read, write: if true;
    }

    match /matches/{matchId} {
      allow read, write: if true;
    }
  }
}
